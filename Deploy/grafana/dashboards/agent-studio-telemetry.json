{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Workflows Started (Total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "agentstudio_workflows_started_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Workflows Completed (Total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "agentstudio_workflows_completed_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Workflows Failed (Total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "agentstudio_workflows_failed_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Last Execution Duration (ms)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "agentstudio_last_execution_duration_ms",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5000 },
              { "color": "red", "value": 15000 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Agent Nodes Saved & Deleted",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "agentstudio_nodes_saved_total",
          "legendFormat": "Nodes Saved",
          "refId": "A"
        },
        {
          "expr": "agentstudio_nodes_deleted_total",
          "legendFormat": "Nodes Deleted",
          "refId": "B"
        },
        {
          "expr": "agentstudio_edges_saved_total",
          "legendFormat": "Edges Saved",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "title": "MCP Tools Attached & Agent Executions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "agentstudio_mcp_tools_attached_total",
          "legendFormat": "MCP Tools Attached",
          "refId": "A"
        },
        {
          "expr": "agentstudio_workflows_completed_total",
          "legendFormat": "Completed Executions",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["agent-studio", "opentelemetry", "ai-agents"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "AI Agent Studio - OpenTelemetry Diagnostics",
  "uid": "agent-studio-otel",
  "version": 1
}
