{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp": "Debug"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "backend-service": {
        "Destinations": {
          "service-local": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "frontend-client": {
        "Destinations": {
          "vite-local": {
            "Address": "http://localhost:5173"
          }
        }
      },
      "keycloak": {
        "Destinations": {
          "keycloak-local": {
            "Address": "http://localhost:8080"
          }
        }
      },
      "grafana": {
        "Destinations": {
          "grafana-local": {
            "Address": "http://localhost:3000"
          }
        }
      }
    }
  }
}
