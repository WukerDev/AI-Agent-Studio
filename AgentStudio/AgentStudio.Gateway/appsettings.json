{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:5000",
      "http://localhost:5002"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "grpc-route": {
        "ClusterId": "backend-service",
        "Order": 1,
        "CorsPolicy": "GatewayCorsPolicy",
        "Match": {
          "Path": "/AgentStudio.AgentFlowService/{**catch-all}"
        }
      },
      "signalr-route": {
        "ClusterId": "backend-service",
        "Order": 2,
        "CorsPolicy": "GatewayCorsPolicy",
        "Match": {
          "Path": "/events/{**catch-all}"
        }
      },
      "api-route": {
        "ClusterId": "backend-service",
        "Order": 3,
        "CorsPolicy": "GatewayCorsPolicy",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "keycloak-route": {
        "ClusterId": "keycloak",
        "Order": 4,
        "CorsPolicy": "GatewayCorsPolicy",
        "Match": {
          "Path": "/identity/{**catch-all}"
        }
      },
      "keycloak-root-route": {
        "ClusterId": "keycloak",
        "Order": 5,
        "CorsPolicy": "GatewayCorsPolicy",
        "Match": {
          "Path": "/identity"
        }
      },
      "grafana-route": {
        "ClusterId": "grafana",
        "Order": 10,
        "Match": {
          "Path": "/grafana/{**catch-all}"
        }
      },
      "frontend-fallback-route": {
        "ClusterId": "frontend-client",
        "Order": 100,
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "backend-service": {
        "Destinations": {
          "service1": {
            "Address": "http://agentstudio.service:8080"
          }
        }
      },
      "frontend-client": {
        "Destinations": {
          "client1": {
            "Address": "http://agentstudio.client:8080"
          }
        }
      },
      "keycloak": {
        "Destinations": {
          "keycloak1": {
            "Address": "http://keycloak:8080"
          }
        }
      },
      "grafana": {
        "Destinations": {
          "grafana1": {
            "Address": "http://grafana:3000"
          }
        }
      }
    }
  }
}
