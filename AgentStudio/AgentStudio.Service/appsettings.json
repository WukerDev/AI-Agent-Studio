{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=agents;Username=keycloak;Password=keycloak_password"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexFormat": "agentstudio-logs-{0:yyyy.MM.dd}"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/identity/realms/agent-studio",
    "Audience": "vue-client"
  },
  "Auth": {
    "AllowGuestFallback": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost",
      "https://localhost:443",
      "http://localhost",
      "http://localhost:80",
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:5000",
      "http://localhost:5002"
    ]
  },
  "AiProviders": {
    "DefaultProvider": "Ollama",
    "OpenAI": {
      "ApiKey": "",
      "Endpoint": "https://api.openai.com/v1",
      "DefaultModel": "gpt-4o"
    },
    "Gemini": {
      "ApiKey": "",
      "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "DefaultModel": "gemini-3.5-flash-lite"
    },
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "DefaultModel": "gemma3:12b"
    }
  },
  "AllowedHosts": "*"
}
