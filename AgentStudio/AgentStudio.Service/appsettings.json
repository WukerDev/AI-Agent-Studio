{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=agentstudio;Username=postgres;Password=postgres"
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "IndexFormat": "agentstudio-logs-{0:yyyy.MM.dd}"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/identity/realms/agent-studio",
    "Audience": "vue-client"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:5000",
      "http://localhost:5002"
    ]
  },
  "AiProviders": {
    "OpenAI": {
      "ApiKey": "",
      "Endpoint": "https://api.openai.com/v1",
      "DefaultModel": "gpt-4o"
    },
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "DefaultModel": "llama3.2"
    }
  },
  "AllowedHosts": "*"
}
