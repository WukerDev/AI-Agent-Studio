<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="FluentValidation" Version="12.2.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="dist\**" CopyToPublishDirectory="Always" />
    </ItemGroup>

    <Target Name="NpmInstall" BeforeTargets="Build" Condition="'$(NpmBuild)' != 'false' And !Exists('node_modules')">
        <Exec Command="npm install" WorkingDirectory="$(ProjectDir)" />
    </Target>

    <Target Name="NpmBuild" BeforeTargets="Build" Condition="'$(NpmBuild)' != 'false'">
        <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" />
    </Target>

</Project>
