<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <Target Name="NpmInstall" BeforeTargets="Build" Condition="!Exists('src\node_modules')">
        <Exec Command="npm install" WorkingDirectory="$(ProjectDir)src" />
    </Target>

    <Target Name="NpmBuild" BeforeTargets="Build">
        <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)src" />
    </Target>

</Project>